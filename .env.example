DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_customer_support_db

RAG_API_BASE_URL=http://127.0.0.1:8000
REFUND_POLICY_DOCUMENT_ID=replace_with_uploaded_document_id
JWT_SECRET_KEY=replace_with_a_secure_random_secret
REVIEWER_JWT_SECRET_KEY=replace_with_a_different_secure_random_secret

# Use LangGraph as the Agent execution engine
USE_LANGGRAPH_AGENT=false